{
  "name": "treecord-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "check:parity": "node scripts/check-parity.ts",
    "format": "prettier --write . && eslint --fix --fix-type layout .",
    "format:check": "prettier --check . && eslint --max-warnings=0 .",
    "lint": "eslint --max-warnings=0 .",
    "lint:files": "eslint --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "prettier --check . && eslint --max-warnings=0 . && tsc --noEmit && knip",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "5.3.0",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  }
}
