# The local stack of compose.yaml (ADR-018). Copy to .env; every variable is docs/BE/be-stack.md §5.
PORT=4000
DATABASE_URL=postgres://treecord:treecord@127.0.0.1:5432/treecord
DATABASE_POOL_MAX=10
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# From your Privy app (dashboard.privy.io); the API never starts without them (ADR-007)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# anvil account 2: a public, well-known dev key, registered as the attester by Deploy.s.sol. Local only.
ATTESTER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=treecord
S3_SECRET_KEY=treecord-secret
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:3001
DEMO_WALLET_AUTH=false
LOG_LEVEL=info
