# The local stack of compose.yaml (ADR-018). Copy to .env; every variable is docs/BE/be-stack.md §5.
PORT=4000
DATABASE_URL=postgres://treecord:treecord@127.0.0.1:5432/treecord
DATABASE_POOL_MAX=10
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# From your Privy app (dashboard.privy.io); the API never starts without them (ADR-007)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# anvil account 2: a public, well-known dev key, registered as the attester by Deploy.s.sol. Local only.
ATTESTER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=treecord
S3_SECRET_KEY=treecord-secret
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:4000
DEMO_WALLET_AUTH=false
# Testnet faucet (anvil or Base Sepolia only): what a newly stored wallet is sent once, in wei and USDC base
# units. Both unset turns it off.
# FAUCET_ETH_WEI=5000000000000000
# FAUCET_USDC_UNITS=10000000000
# Testnet only (worker): the operator wallet fills every campaign still funding, so it turns active at once.
# AUTO_FUND=true
LOG_LEVEL=info

# The worker (npm run worker, ADR-021) reads this same file. NFR-076: one process in WORKER_MODE all or relayer per
# operator and relayer wallet. anvil accounts 1 and 3: public, well-known dev keys (contracts/.env.anvil). Local only.
WORKER_MODE=all
WORKER_PORT=8080
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
MOCK_AI=true
# AI_SERVICE_URL=
# AI_SERVICE_TOKEN=
# WORKER_DATABASE_POOL_MAX=5
# INDEXER_POLL_MS=4000
# INDEXER_CHUNK_BLOCKS=2000
# INDEXER_CONFIRMATIONS=2
# INDEXER_RESCAN_BLOCKS=5
# INDEXER_START_BLOCK=
# RELAYER_POLL_MS=2000
# SCHEDULER_INTERVAL_MS=60000
